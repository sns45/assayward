{
  "name": "@sns45/assayward",
  "version": "0.1.0",
  "description": "TypeScript wrapper around the assayward wasm core — evaluate supply-chain trust policies at the edge",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "bundledDependencies": [],
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target bun --format esm && tsc --emitDeclarationOnly --declaration --declarationDir dist",
    "test": "bun test src/index.test.ts",
    "typecheck": "bun tsc --noEmit"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sns45/assayward.git",
    "directory": "surfaces/npm"
  },
  "keywords": [
    "supply-chain",
    "policy",
    "wasm",
    "slsa",
    "attestation",
    "sigstore",
    "edge"
  ],
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
